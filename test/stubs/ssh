#!/usr/bin/env bash
# Test double for ssh. Logs its arguments to $BOAT_STUB_DIR/ssh.log and every script it receives on
# stdin to $BOAT_STUB_DIR/ssh-scripts.log, then answers by what the script is:
#
#   repo state probe        -> prints "commit"          gh wrapper install  -> exit 0
#   resume origin probe     -> prints acme/widgets      git identity script -> exit 0
#   GitHub access probe     -> exit code from $BOAT_STUB_DIR/ssh-github.rc (default 0); with the file
#                              ssh-needs-setup-git it exits 128 unless `gh auth setup-git` runs first
#   checkout + setup script -> exit code from $BOAT_STUB_DIR/ssh-checkout.rc (default 0)
#   machine ID restore      -> prints $BOAT_STUB_DIR/ssh-machine-id.out (default "same"), then exits
#                              with the code from $BOAT_STUB_DIR/ssh-machine-id.rc (default 0)
set -u
dir="${BOAT_STUB_DIR:?}"
printf '%s\n' "$*" >>"$dir/ssh.log"

args=("$@")
remote="${args[$((${#args[@]} - 1))]}"
[ "$remote" != true ] || exit 0

script="$(cat)"
printf '%s\n-----\n' "$script" >>"$dir/ssh-scripts.log"
case "$script" in
  *'restore_machine_id'*)
    if [ -f "$dir/ssh-machine-id.out" ]; then cat "$dir/ssh-machine-id.out"; else echo same; fi
    rc=0
    if [ -f "$dir/ssh-machine-id.rc" ]; then rc="$(cat "$dir/ssh-machine-id.rc")"; fi
    exit "$rc"
    ;;
  *'main </dev/null'*)
    rc=0
    if [ -f "$dir/ssh-checkout.rc" ]; then rc="$(cat "$dir/ssh-checkout.rc")"; fi
    if [ "$rc" -ne 0 ]; then echo "error: setupScript 'x' failed (exit $rc)" >&2; fi
    exit "$rc"
    ;;
  *'git ls-remote'*)
    rc=0
    if [ -f "$dir/ssh-github.rc" ]; then rc="$(cat "$dir/ssh-github.rc")"; fi
    # A new sandbox has a gh login but no git credential helper until `gh auth setup-git` runs.
    if [ -f "$dir/ssh-needs-setup-git" ]; then
      case "${script%%git ls-remote*}" in *'gh auth setup-git'*) ;; *) rc=128 ;; esac
    fi
    exit "$rc"
    ;;
  *'echo none'*)
    echo commit
    ;;
  *'config --get remote.origin.url'*)
    echo acme/widgets
    ;;
esac
exit 0
